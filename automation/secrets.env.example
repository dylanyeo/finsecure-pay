# =============================================================================
# FinSecure Pay - SECRETS
# Copy to automation/secrets.env and keep it private (chmod 600). It is git-ignored.
# ./finsecure.sh 0 -> step 1 prompts for these and generates the random ones.
# Never paste these values into code, commits, screenshots or the presentation.
# =============================================================================

DOCKERHUB_TOKEN=""          # Docker Hub > Account settings > Personal access tokens (Read & Write)
SONAR_TOKEN=""              # SonarQube Cloud > My Account > Security > Generate token
NVD_API_KEY=""              # https://nvd.nist.gov/developers/request-an-api-key (free)
SMTP_PASSWORD=""            # Gmail App Password (16 characters, requires 2-Step Verification)

# Generated automatically if left empty
JENKINS_ADMIN_PASSWORD=""
GRAFANA_ADMIN_PASSWORD=""
FINSECURE_API_KEY=""        # API key clients send in the X-API-Key header
