# =============================================================================
# FinSecure Pay - non-secret configuration
# Copy to automation/config.env (./finsecure.sh 0 -> step 1 does this for you).
# automation/config.env is git-ignored.
# =============================================================================

# --- GitHub (repository must be PUBLIC so the evaluator and SonarQube Cloud can read it)
GITHUB_USER="your-github-username"
GITHUB_REPO="finsecure-pay"

# --- Docker Hub
DOCKERHUB_USER="your-dockerhub-username"
DOCKERHUB_REPO="your-dockerhub-username/finsecure-pay"

# --- AWS / EKS
AWS_REGION="ap-southeast-1"           # Singapore
AWS_PROFILE="default"                 # profile created by 'aws configure' (Setup step 3)
EKS_CLUSTER="finsecure-eks"
EKS_VERSION="1.34"                    # Kubernetes version (eksctl default, standard support)
EKS_NODE_COUNT="2"
EKS_INSTANCE_TYPE="t3.large"          # 2 vCPU / 8 GB per node (monitoring stack needs the memory)
EKS_SPOT="false"                      # "true" = Spot nodes, ~60-70% cheaper but can be interrupted

# --- SonarQube Cloud (https://sonarcloud.io - free for public repositories)
SONAR_ENABLED="true"                  # set to "false" to skip the code-quality stage
SONAR_ORG="your-sonarcloud-organization-key"
SONAR_PROJECT_KEY="your-github-username_finsecure-pay"

# --- Notifications (Gmail with an App Password - see README)
SMTP_USER="you@gmail.com"             # account that sends Jenkins and Alertmanager emails
NOTIFY_EMAIL="you@gmail.com"          # where notifications are delivered

# --- Jenkins (runs in Docker on this machine)
JENKINS_ADMIN_USER="admin"
JENKINS_PORT="8080"
JENKINS_BIND_ADDRESS="0.0.0.0"        # use 127.0.0.1 to allow access from this machine only
JENKINS_HOST=""                       # leave empty to auto-detect this machine's LAN IP
