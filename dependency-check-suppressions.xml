<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppressions.
  Only add an entry after a finding has been reviewed and confirmed as a false positive or as not
  exploitable in this application. Every suppression needs a reason and an expiry date (until=...),
  so accepted risks are revisited instead of being hidden forever.

  Example:
  <suppress until="2026-12-31Z">
     <notes>False positive: CVE applies to the Tomcat AJP connector, which this service does not enable.</notes>
     <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat\-embed\-core@.*$</packageUrl>
     <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <suppress until="2026-12-31Z">
     <notes>Risk accepted (docs/SECURITY-EXCEPTIONS.md, SEC-001): CVE-2026-47884 needs Spring MVC XsltView, which this
       service does not use. Open-source fix only in Spring Framework 7.0.9; upgrade to Spring Boot 4 planned.</notes>
     <packageUrl regex="true">^pkg:maven/org\.springframework/spring\-.*@6\.2\..*$</packageUrl>
     <cve>CVE-2026-47884</cve>
  </suppress>
  <suppress until="2026-12-31Z">
     <notes>Risk accepted (docs/SECURITY-EXCEPTIONS.md, SEC-002): CVE-2026-47890 needs view fragments streamed over
       Server-Sent Events, which this service does not use. Open-source fix only in Spring Framework 7.0.9.</notes>
     <packageUrl regex="true">^pkg:maven/org\.springframework/spring\-.*@6\.2\..*$</packageUrl>
     <cve>CVE-2026-47890</cve>
  </suppress>
</suppressions>
